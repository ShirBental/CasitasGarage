[Unit]
Description=Casita (Bental's Casita garage app on watson)
Documentation=file:///opt/casita/current/docs/WATSON_DEPLOYMENT_READINESS.md
Wants=network-online.target
After=network-online.target
# A refused start (the staging guard, a missing Firestore schema) fails the same way each time: stop retrying.
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=casita
Group=casita
# The settings, including JAVA_OPTS. StagingGuard refuses to start unless they are a complete staging (simulated)
# or production (the real doors; deploy/watson/LIVE_DOORS.md).
EnvironmentFile=/etc/casita/casita.env
# Production only: the Meross account (CASITA_MEROSS_EMAIL, CASITA_MEROSS_PASSWORD), root-only 0600. systemd reads it as
# root before starting Casita; staging has none (the guard refuses credentials there).
EnvironmentFile=-/etc/casita/meross.env
# The working directory holds nothing but data: no config/meross.local.json can be picked up from here.
WorkingDirectory=/var/lib/casita
ExecStart=/usr/bin/java $JAVA_OPTS -jar /opt/casita/current/casita.jar
SuccessExitStatus=143
Restart=on-failure
RestartSec=5
TimeoutStopSec=20

# Memory: the JVM is capped at 128 MiB of heap (JAVA_OPTS) and measured at about 200 MiB RSS. This is a hard
# ceiling well below the VM's 1 GiB, so a leak ends in a restart instead of starving Caddy and sshd.
MemoryHigh=384M
MemoryMax=512M

# Hardening: Casita writes only its data directory; it needs the network (Firestore, Meross, loopback for Caddy),
# nothing else.
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/casita
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
# AF_NETLINK: the JVM may read network interfaces through it (gRPC and Netty look them up at start).
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077

[Install]
WantedBy=multi-user.target
