# Casita on watson (GCP staging): /etc/casita/casita.env, owned root:casita, mode 0640. Read by casita.service.
#
# Fill in every <...> before the first start. Casita refuses to start (StagingGuard, docs/STAGING_GUARD.md)
# while the tailnet is a placeholder, and the family and project placeholders fail their own checks.
# StagingEnvironmentVariablesTest starts Casita with exactly these names, so they are the ones Spring binds.
# Nothing secret belongs in this file: no Meross credentials (staging refuses them), no keys.

# Where Casita runs. On a Compute Engine VM, only 'staging' starts.
CASITA_DEPLOYMENT=staging

# Simulation only: Ford and Toyota are practice doors and nothing reaches Meross. Staging refuses anything else.
CASITA_DOOR=simulated
CASITA_MEROSS_COMMANDMODE=off

# Sign-in. Passkeys are bound to this host name: set it to the verified tailnet name before anyone enrolls.
# Renaming it later means everyone enrolls again.
CASITA_SECURITY_RPID=watson.<TAILNET>.ts.net
CASITA_SECURITY_ALLOWEDORIGINS=https://watson.<TAILNET>.ts.net
# Who may sign in, by short name, comma-separated (lower case, e.g. shir,hubby).
CASITA_SECURITY_FAMILY=<MEMBERS>
CASITA_SECURITY_DEVICEIDENTITY=tailscale
CASITA_SECURITY_TAILSCALECLI=/usr/bin/tailscale
# The admin secret and invite links (owner-only files). Members, passkeys and devices live in Firestore.
CASITA_SECURITY_DATADIR=/var/lib/casita

# The security store: the project's (default) Firestore database, through the VM's service account (ADC).
CASITA_STORAGE_TYPE=firestore
CASITA_STORAGE_FIRESTORE_PROJECTID=<PROJECT_ID>

# Sessions are HTTPS-only behind tailscale serve.
SERVER_SERVLET_SESSION_COOKIE_SECURE=true

# The JVM, sized for an e2-micro (1 GiB): the tuned flags measured in docs/firestore-benchmark/RESULTS.md
# (196 MiB max RSS over a 60-minute soak with Firestore). Not a Spring setting; casita.service passes it to java.
JAVA_OPTS=-XX:MaxRAM=1g -XX:ActiveProcessorCount=2 -XX:+UseSerialGC -Xms32m -Xmx128m -XX:MaxMetaspaceSize=128m -XX:ReservedCodeCacheSize=48m -Xss512k -XX:TieredStopAtLevel=1 -XX:+ExitOnOutOfMemoryError
