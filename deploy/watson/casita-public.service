[Unit]
Description=Casita public preview (simulated doors, public sign-in, during the move to public HTTPS)
Documentation=file:///opt/casita-public/current/PUBLIC_HTTPS.md
Wants=network-online.target
After=network-online.target
# A refused start (the staging guard, a missing Firestore schema) fails the same way each time: stop retrying.
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=casita
Group=casita
# Temporary (docs/PUBLIC_HTTPS.md): the new release, as staging (simulated doors only; the guard refuses anything else),
# on 127.0.0.1:8081 behind Caddy, so new passkeys can be set up on the public name while casita.service keeps serving
# the old access path. Same data directory and Firestore as casita.service, so what is enrolled here carries over at
# cutover. No Meross account file: staging refuses credentials.
EnvironmentFile=/etc/casita-public/casita.env
# The working directory holds nothing but data: no config/meross.local.json can be picked up from here.
WorkingDirectory=/var/lib/casita
ExecStart=/usr/bin/java $JAVA_OPTS -jar /opt/casita-public/current/casita.jar
SuccessExitStatus=143
Restart=on-failure
RestartSec=5
TimeoutStopSec=20

# Memory: the JVM is capped at 128 MiB of heap (JAVA_OPTS) and measured at about 200 MiB RSS. This is a hard
# ceiling well below the VM's 1 GiB, so a leak ends in a restart instead of starving Caddy and sshd.
MemoryHigh=384M
MemoryMax=512M

# Hardening: Casita writes only its data directory; it needs the network (Firestore, Meross, loopback for Caddy),
# nothing else.
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/casita
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
# AF_NETLINK: the JVM may read network interfaces through it (gRPC and Netty look them up at start).
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077

[Install]
WantedBy=multi-user.target
