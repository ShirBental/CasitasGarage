#!/bin/sh
# Casita access administration, on the server only. Talks to Casita on 127.0.0.1 with the admin secret
# from <data-dir>/admin.secret (created by Casita on first start, readable by its user only).
#
#   bin/casita-access list
#   bin/casita-access invite <member> "<device label>"     # writes the link to <data-dir>/invites/<id>.txt
#   bin/casita-access revoke-invite <invite id>
#   bin/casita-access revoke-device <node id>            # the tailnet node's StableID, from 'list'
#   bin/casita-access release-device <node id>           # a revoked node may then be enrolled for anyone
#   bin/casita-access revoke-passkey <credential id>
#   bin/casita-access revoke-member <member>               # all their devices, passkeys, invites and Shortcut tokens
#   bin/casita-access shortcut-token <member> "<device label>" [days]   # Siri: opens Ford only; the token is shown once
#   bin/casita-access shortcut-tokens                      # lists them (never the tokens themselves)
#   bin/casita-access revoke-shortcut-token <token id>     # st-..., from 'shortcut-tokens'
#
# CASITA_URL (default http://127.0.0.1:8080) and CASITA_DATA (default ./data) override the defaults.
set -eu

url="${CASITA_URL:-http://127.0.0.1:8080}"
data="${CASITA_DATA:-data}"
secret_file="$data/admin.secret"

usage() { awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' "$0"; exit 2; }

[ $# -ge 1 ] || usage
[ -r "$secret_file" ] || { echo "Can't read $secret_file: start Casita once, and run this as its user." >&2; exit 1; }

# The secret goes to curl on stdin as a header file, never on the command line (where ps would show it).
# Any answer other than success (an error status, or no answer at all) ends with FAILED and exit code 1.
call() {
  method="$1"; shift
  if printf 'X-Casita-Admin: %s\n' "$(cat "$secret_file")" |
      curl --silent --show-error --fail-with-body --noproxy '*' -H @- -X "$method" "$@"; then
    echo
  else
    echo
    echo "casita-access: FAILED: see the answer above; don't rely on the change having happened" >&2
    exit 1
  fi
}

case "$1" in
  list)           call GET "$url/admin/access" ;;
  invite)         [ $# -eq 3 ] || usage
                  call POST "$url/admin/invites" --data-urlencode "member=$2" --data-urlencode "label=$3" ;;
  revoke-invite)  [ $# -eq 2 ] || usage; call DELETE "$url/admin/invites/$2" ;;
  revoke-device)  [ $# -eq 2 ] || usage; call DELETE "$url/admin/devices/$2" ;;
  release-device) [ $# -eq 2 ] || usage; call POST "$url/admin/devices/$2/release" ;;
  revoke-passkey) [ $# -eq 2 ] || usage; call DELETE "$url/admin/credentials/$2" ;;
  revoke-member)  [ $# -eq 2 ] || usage; call DELETE "$url/admin/members/$2" ;;
  shortcut-token) [ $# -eq 3 ] || [ $# -eq 4 ] || usage
                  call POST "$url/admin/shortcut-tokens" --data-urlencode "member=$2" --data-urlencode "label=$3" \
                    --data-urlencode "days=${4:-180}" ;;
  shortcut-tokens) call GET "$url/admin/shortcut-tokens" ;;
  revoke-shortcut-token) [ $# -eq 2 ] || usage; call DELETE "$url/admin/shortcut-tokens/$2" ;;
  *)              usage ;;
esac
